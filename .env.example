# Copy to .env.local and fill in your own values.
# .env.local is gitignored and must never be committed.

# ---- Supabase ----
# Project URL and keys from https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET key - server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# ---- Chain ----
# 151 = Redbelly Mainnet, 153 = Redbelly Testnet. The DAO runs on 151.
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RPC_URL=

# ---- Space ----
NEXT_PUBLIC_SPACE_ID=
NEXT_PUBLIC_SPACE_NAME=

# ---- Optional: RBNT as an ERC20 rather than the native coin ----
# Leave blank to use native RBNT balances for voting power.
NEXT_PUBLIC_TOKEN_ADDRESS=

# ---- Optional: on-chain identity verification contract ----
# Leave blank to use Redbelly's own network access contract, which is built
# into lib/chains.ts for mainnet (chain 151):
#   0xcb385cD90ca6b219798F57B4a7958897e91A9163  ->  isAllowed(address)
# Testnet has no equivalent, so it falls back to the verified_addresses
# table in Supabase. Set this only to override the built-in address.
NEXT_PUBLIC_IDENTITY_REGISTRY=

# ---- Proposal validation ----
# RBNT an address must hold to open a proposal. Space admins are exempt.
# 0 lets anyone propose. Snapshot calls this proposal validation.
NEXT_PUBLIC_PROPOSAL_THRESHOLD=1000

# ---- Optional: staking pools counted as RBNT held ----
# Comma separated. Defaults to Reddex's two RBNT pools on mainnet, which are
# built into lib/staking.ts. Set to an empty string to count wallet only.
NEXT_PUBLIC_STAKING_POOLS=

# ---- Wallet connections on mobile ----
# A phone browser has no wallet extension, so injected connections only work
# inside a wallet app's own browser. A free project ID from
# https://cloud.reown.com adds WalletConnect, which reaches the wallet app
# from any mobile browser. Leave blank to offer browser wallets only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---- Optional: IPFS receipts ----
# Every proposal and ballot signed here is pinned to IPFS, so the signature
# can be re-checked by anyone without asking this server for the payload.
# Leave blank and the portal behaves as it did before receipts existed: votes
# are recorded normally, they just carry no independent copy.
#
# A free Pinata plan is far more than this DAO needs. The entire history to
# date — 31 proposals and 547 ballots — is about 300 KB, and the measured
# growth is well under 1 MB a year.
# JWT from https://app.pinata.cloud -> API Keys (pinJSONToIPFS permission).
PINATA_JWT=

# Optional second provider, mirroring by CID once Pinata has the bytes. Any
# IPFS Pinning Service API endpoint works (Filebase, 4everland, your own node).
# The real risk to this archive was never volume, it was one provider changing
# its free tier, and two providers is what makes that survivable.
IPFS_PIN_SERVICE_URL=
IPFS_PIN_SERVICE_TOKEN=

# Gateway the "Verify on IPFS" links point at for receipts pinned here.
# Imported Snapshot receipts always use Snapshot's own gateway, since that is
# where they are actually held. Defaults to https://ipfs.io.
NEXT_PUBLIC_IPFS_GATEWAY=

# Guards GET /api/ipfs/pin, which pins anything the live path missed. Vercel
# sends this header automatically on scheduled runs. Unset, the endpoint
# refuses everyone rather than letting a stranger spend the storage quota.
CRON_SECRET=

# ---- Optional: the 11-point proposal check ----
# Every proposal is checked by AI against the DAO's review checklist before it
# can be published (lib/screening-criteria.ts). Needs migration 011. Leave the
# key blank and proposals publish on signature alone, as before. Server only:
# never prefix these with NEXT_PUBLIC_.
# Gonka is OpenAI-compatible; copy the base URL from the dashboard as shown
# (the portal appends /chat/completions).
GONKA_API_KEY=
GONKA_BASE_URL=
# Defaults: zai-org/GLM-5.3-Flash, falling back to DeepSeek-V4-Flash-0731.
GONKA_MODEL=
GONKA_FALLBACK_MODEL=

# ---- Optional: one person, one vote (Self) ----
# Members scan a passport, a chip national ID (Pakistan's NIC works) or
# Aadhaar in the free Self app, and each document can verify one wallet.
# Needs migration 012. Leave the scope blank and the feature is hidden.
# At most 31 ASCII characters, and never change it once members have
# verified: Self derives every nullifier from it, so a new scope means
# everyone verifies again.
NEXT_PUBLIC_SELF_SCOPE=
# Where the Self app posts proofs. Must be public HTTPS, so localhost never
# works. Defaults to NEXT_PUBLIC_SITE_URL + /api/personhood/verify; set
# NEXT_PUBLIC_SITE_URL on preview deployments rather than this.
NEXT_PUBLIC_SELF_ENDPOINT=
# true = accept Self's mock documents for rehearsal (Celo testnet). Ignored
# on production deployments (VERCEL_ENV=production) whatever it is set to.
NEXT_PUBLIC_SELF_MOCK=
